# Your Homebox (>= 0.26) instance
HOMEBOX_URL=http://127.0.0.1:7745
# An API key from Homebox → Profile → API Keys (starts with hb_) ...
HOMEBOX_TOKEN=hb_xxxxxxxxxxxxxxxxxxxxxxxx
# ... or log in with a user instead
# HOMEBOX_EMAIL=you@example.com
# HOMEBOX_PASSWORD=...

# Where homebox-3d listens (keep it on localhost unless you put auth in front of it)
PORT=7750
HOST=127.0.0.1
# How often to check Homebox for changes
POLL_MS=1500
